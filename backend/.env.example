# SuperMart SAS - Backend Environment Configuration Example
# Copy this file to .env and provide your actual secrets/credentials.
# NEVER commit the real .env file to version control.

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/supermart_sas?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/supermart_sas?retryWrites=true&w=majority

# JWT Authentication Secret Key (use a strong random 32+ character string)
JWT_SECRET=supermart_sas_jwt_secure_secret_key_2026_se_lab_project

# JWT Token Expiration (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_ORIGIN=https://yash8092-code.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
